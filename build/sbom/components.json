    {
      "id": "st-hal-f7",
      "name": "STM32F7 HAL driver",
      "version": "1.3.3",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/stm32f7xx_hal_driver.git@v1.3.3",
      "purl": "pkg:github/stmicroelectronics/stm32f7xx_hal_driver@v1.3.3",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-hal-f7).",
      "paths": ["deps/stm32/f7/hal"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M7"] }
    },
    {
      "id": "riscv-csr-encoding",
      "name": "RISC-V CSR encoding header (riscv-opcodes)",
      "supplier": "Organization: RISC-V International",
      "license": "BSD-3-Clause",
      "copyright": "Copyright RISC-V International",
      "download": "https://github.com/riscv/riscv-opcodes",
      "purl": "pkg:github/riscv/riscv-opcodes",
      "relationship": "DEPENDS_ON",
      "comment": "Selected as the device header (_STK_DEVICE_INC) for RISC-V builds; generated from riscv-opcodes (BSD-3-Clause).",
      "paths": ["deps/target/risc-v/include/risc-v/encoding.h"],
      "when": { "all": ["RISCV"], "none": ["VENDOR_RPI"] }
    },
    {
      "id": "riscv-startup",
      "name": "RISC-V startup code, vector table and linker script",
      "supplier": "Organization: Neutron Code Limited (stk@neutroncode.com)",
      "license": "MIT",
      "copyright": "Copyright (c) 2022-2026 Neutron Code Limited <stk@neutroncode.com>",
      "homepage": "https://github.com/SuperTinyKernel-RTOS/stk/tree/main/deps/target/risc-v",
      "download": "git+https://github.com/SuperTinyKernel-RTOS/stk/deps/target/risc-v",
      "relationship": "DEPENDS_ON",
      "comment": "startup.c, vector_table.c, vector_table.h and linker script of the RISC-V target support library.",
      "paths": [
        "deps/target/risc-v/src/init/startup.c",
        "deps/target/risc-v/src/init/vector_table.c",
        "deps/target/risc-v/src/init/vector_table.h",
        "deps/target/risc-v/src/ld/stk.ld",
        "deps/target/risc-v/src/ld/stk-mpu.ld"
      ],
      "when": {
        "all": [ "RISCV" ],
        "none": [ "VENDOR_RPI" ]
      }
    },
    {
      "id": "segger-systemview",
      "name": "SEGGER RTT and SystemView",
      "version": "3.30",
      "supplier": "Organization: SEGGER Microcontroller GmbH",
      "license": "LicenseRef-SEGGER-SystemView",
      "copyright": "Copyright (c) 1995-2021 SEGGER Microcontroller GmbH",
      "download": "https://www.segger.com/products/development-tools/systemview/",
      "relationship": "STATIC_LINK",
      "comment": "Tracing, linked in when ENABLE_SEGGER_SYSVIEW=ON. SEGGER recommends not to modify these sources.",
      "paths": ["deps/segger"],
      "when": { "all": ["ENABLE_SEGGER_SYSVIEW"] }
    }
  ]
