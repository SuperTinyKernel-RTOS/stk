{
  "schema": 1,

  "scope_note": "Scope: the STK library and the third-party code its build configuration brings in. Not covered: examples, benchmarks, tests (CppUTest), interop adapters for other RTOS APIs (CMSIS-RTOS2, Infineon abstraction layer, FreeRTOS/ThreadX shims), middleware ports (lwIP, mbedTLS, TinyUSB) and the Raspberry Pi target.",

  "unsupported_when": {
    "any": ["VENDOR_RPI"],
    "reason": "Raspberry Pi (Pico SDK) targets are not covered by the SBOM yet"
  },

  "root": {
    "name": "stk",
    "description": "SuperTinyKernel RTOS (STK): lightweight high-performance deterministic C++ RTOS for embedded systems.",
    "supplier": "Organization: Neutron Code Limited (stk@neutroncode.com)",
    "license": "MIT",
    "copyright": "Copyright (c) 2022-2026 Neutron Code Limited <stk@neutroncode.com>",
    "homepage": "https://github.com/SuperTinyKernel-RTOS/stk",
    "download": "git+https://github.com/SuperTinyKernel-RTOS/stk",
    "purl": "pkg:github/supertinykernel-rtos/stk"
  },

  "license_refs": {
    "LicenseRef-SEGGER-SystemView": {
      "name": "SEGGER SystemView and RTT license",
      "file": "LICENSES/LicenseRef-SEGGER-SystemView.txt"
    }
  },

  "components": [
    {
      "id": "st-cmsis-core",
      "name": "Arm CMSIS-Core headers (as published by STMicroelectronics)",
      "version": "5.9.0",
      "supplier": "Organization: Arm Limited",
      "license": "Apache-2.0",
      "copyright": "Copyright (c) Arm Limited",
      "download": "git+https://github.com/STMicroelectronics/cmsis_core.git@v5.9.0",
      "purl": "pkg:github/stmicroelectronics/cmsis_core@v5.9.0",
      "relationship": "DEPENDS_ON",
      "comment": "Core headers (core_cm*.h, cmsis_gcc.h, ...) included through the device header (_STK_DEVICE_INC) when compiling the library. Fetched by deps/scripts/fetch_deps.py (only the Include directory).",
      "paths": ["deps/stm32/cmsis-core"],
      "when": { "all": ["VENDOR_STM32"] }
    },
    {
      "id": "stk-cortexm-glue",
      "name": "SuperTinyKernel RTOS Cortex-M startup, newlib and trace glue",
      "supplier": "Organization: Neutron Code Limited (stk@neutroncode.com)",
      "license": "MIT",
      "copyright": "Copyright (c) 2022-2026 Neutron Code Limited <stk@neutroncode.com>",
      "download": "git+https://github.com/SuperTinyKernel-RTOS/stk/tree/main/deps/target/stm32",
      "relationship": "DEPENDS_ON",
      "comment": "Startup sequence, exception handlers, newlib syscalls, trace and linker scripts of the stm32 target support library.",
      "paths": [
        "deps/target/stm32"
      ],
      "when": { "all": ["VENDOR_STM32"] }
    },
    {
      "id": "st-cmsis-device-f0",
      "name": "STM32F0 CMSIS device files (start-up code, system file, device headers)",
      "version": "2.3.4",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/cmsis_device_f0.git@v2.3.4",
      "purl": "pkg:github/stmicroelectronics/cmsis_device_f0@v2.3.4",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-cmsis-device-f0).",
      "paths": ["deps/stm32/f0/cmsis-device"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M0"] }
    },
    {
      "id": "st-hal-f0",
      "name": "STM32F0 HAL driver",
      "version": "1.7.4",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/stm32f0xx_hal_driver.git@v1.7.4",
      "purl": "pkg:github/stmicroelectronics/stm32f0xx_hal_driver@v1.7.4",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-hal-f0).",
      "paths": ["deps/stm32/f0/hal"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M0"] }
    },
    {
      "id": "st-cmsis-device-f1",
      "name": "STM32F1 CMSIS device files (start-up code, system file, device headers)",
      "version": "4.3.2",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/cmsis_device_f1.git@v4.3.2",
      "purl": "pkg:github/stmicroelectronics/cmsis_device_f1@v4.3.2",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-cmsis-device-f1).",
      "paths": ["deps/stm32/f1/cmsis-device"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M3"] }
    },
    {
      "id": "st-hal-f1",
      "name": "STM32F1 HAL driver",
      "version": "1.1.7",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/stm32f1xx_hal_driver.git@v1.1.7",
      "purl": "pkg:github/stmicroelectronics/stm32f1xx_hal_driver@v1.1.7",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-hal-f1).",
      "paths": ["deps/stm32/f1/hal"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M3"] }
    },
    {
      "id": "st-cmsis-device-f4",
      "name": "STM32F4 CMSIS device files (start-up code, system file, device headers)",
      "version": "2.6.6",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/cmsis_device_f4.git@v2.6.6",
      "purl": "pkg:github/stmicroelectronics/cmsis_device_f4@v2.6.6",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-cmsis-device-f4).",
      "paths": ["deps/stm32/f4/cmsis-device"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M4"] }
    },
    {
      "id": "st-hal-f4",
      "name": "STM32F4 HAL driver",
      "version": "1.7.10",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/stm32f4xx_hal_driver.git@v1.7.10",
      "purl": "pkg:github/stmicroelectronics/stm32f4xx_hal_driver@v1.7.10",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-hal-f4).",
      "paths": ["deps/stm32/f4/hal"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M4"] }
    },
    {
      "id": "st-cmsis-device-f7",
      "name": "STM32F7 CMSIS device files (start-up code, system file, device headers)",
      "version": "1.2.10",
      "supplier": "Organization: STMicroelectronics",
      "license": "BSD-3-Clause",
      "copyright": "Copyright (c) STMicroelectronics",
      "download": "git+https://github.com/STMicroelectronics/cmsis_device_f7.git@v1.2.10",
      "purl": "pkg:github/stmicroelectronics/cmsis_device_f7@v1.2.10",
      "relationship": "DEPENDS_ON",
      "comment": "Fetched by deps/scripts/fetch_deps.py (dependency st-cmsis-device-f7).",
      "paths": ["deps/stm32/f7/cmsis-device"],
      "when": { "all": ["VENDOR_STM32", "TARGET_CORTEX_M7"] }
